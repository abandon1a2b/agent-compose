PORT=4318
# First provider: DeepSeek. Fill the key locally, never commit it.
MODEL_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# For offline protocol/loop checks only: MODEL_MODE=mock

# DeepSeek context window and actual completion output cap.
MODEL_CONTEXT_WINDOW_TOKENS=1000000
MODEL_MAX_OUTPUT_TOKENS=2048
# Compression ratios use (context window - reserved output tokens) as input budget.
CONTEXT_COMPRESSION=true
CONTEXT_TRIGGER_RATIO=0.8
CONTEXT_TARGET_RATIO=0.5
CONTEXT_KEEP_RECENT_TURNS=4
CONTEXT_SUMMARY_MAX_TOKENS=1024
