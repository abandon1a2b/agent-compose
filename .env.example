PORT=4318
# First provider: DeepSeek. Fill the key locally, never commit it.
MODEL_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# For offline protocol/loop checks only: MODEL_MODE=mock

# Runtime and business policy are in JSON; secrets and environment addresses remain here.
# HARNESS_RUNTIME_CONFIG=./configs/runtime.json
# HARNESS_APPLICATION_CONFIG=./configs/applications/decoration.json

# Optional local business adapter; omit to retain Mock publishing.
CONTENT_SERVICE_URL=

# Optional reference client; false starts only the Harness APIs.
SERVE_DEMO_UI=true
