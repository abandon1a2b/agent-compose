{
  "name": "agent-compose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env examples/local-app.ts",
    "dev": "node --watch --env-file-if-exists=.env examples/local-app.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "description": "A lightweight TypeScript agent harness for tools, context, tasks, and human interaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abandon1a2b/agent-compose.git"
  }
}
